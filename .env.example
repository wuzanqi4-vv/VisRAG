# Copy to /home/wuzanqi/VisRAG/.env on the server and fill in real values.
# Keep the real .env private. Never commit API credentials.
CHAT_API_KEY=replace_with_your_api_key
# Provider API root, including its version/compatibility path if required.
# Do not append /chat/completions here.
CHAT_BASE_URL=https://your-api-provider.example/v1
CHAT_MODEL=replace_with_exact_model_id
CHAT_API_FORMAT=chat_completions
# Token consumption is read from response.usage, never configured/estimated.
